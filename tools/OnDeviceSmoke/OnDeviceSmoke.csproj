    this PC using a fixed synthetic prompt. No network, no conversation data. Usage:
    dotnet run (Release) with project tools/OnDeviceSmoke, optional argument: model directory.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>TalkPro.OnDeviceSmoke</AssemblyName>
    <RootNamespace>TalkPro.Tools.OnDeviceSmoke</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TalkPro.Core\TalkPro.Core.csproj" />
    <ProjectReference Include="..\..\src\TalkPro.Llm\TalkPro.Llm.csproj" />
  </ItemGroup>
</Project>
