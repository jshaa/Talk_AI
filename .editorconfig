root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,xaml,json,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- Privacy: logging must use static message templates (no interpolated content) ---
dotnet_diagnostic.CA2254.severity = error
# --- Culture must be explicit (parsers handle Korean dates/times) ---
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error
# --- Crypto hygiene ---
dotnet_diagnostic.CA5394.severity = error
