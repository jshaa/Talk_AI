<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TalkPro.Mobile.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Notice" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#EFF4FA" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="StrokeThickness" Value="0" />
      </Style>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Stroke" Value="#D0D7E2" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
      </Style>
      <Style x:Key="Sub" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,12,0,4" />
      </Style>
      <Style x:Key="Hint" TargetType="Label">
        <Setter Property="TextColor" Value="Gray" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style x:Key="Error" TargetType="Label">
        <Setter Property="TextColor" Value="#B00020" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
