<UserControl x:Class="TalkPro.App.Views.ImportWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,16">
      <TextBlock Style="{StaticResource SectionTitle}" Text="대화 가져오기" />

      <!-- Step 1: attestation before any file is read -->
      <StackPanel Visibility="{Binding IsAttestationStep, Converter={StaticResource BoolToVis}}">
        <TextBlock FontWeight="SemiBold" Text="1단계 · 참여 확인" Margin="0,0,0,6" />
        <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="12" Margin="0,0,0,8">
          <TextBlock Text="{Binding AttestationText}" TextWrapping="Wrap" FontSize="14" />
        </Border>
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="다른 사람의 휴대폰이나 PC에서 몰래 내보낸 대화는 가져올 수 없습니다. 파일은 이 PC 밖으로 전송되지 않습니다." />
        <CheckBox Content="위 내용을 확인했으며 사실입니다." IsChecked="{Binding AttestationChecked}" Margin="0,0,0,8" />
        <Button Content="다음" Command="{Binding ContinueCommand}" HorizontalAlignment="Left" />
      </StackPanel>

      <!-- Step 2: file -->
      <StackPanel Visibility="{Binding IsSelectFileStep, Converter={StaticResource BoolToVis}}">
        <TextBlock FontWeight="SemiBold" Text="2단계 · 내보내기 파일 선택" Margin="0,0,0,6" />
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="메신저의 '대화 내보내기'로 만든 TXT 파일을 선택하세요. 형식은 파일 내용으로 자동 판별합니다." />
        <Button Content="파일 선택..." Command="{Binding PickFileCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="파일을 분석하는 중입니다..." Margin="0,8,0,0"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
      </StackPanel>

      <!-- Step 3: speaker review -->
      <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVis}}">
        <TextBlock FontWeight="SemiBold" Text="3단계 · 참여자 확인" Margin="0,0,0,6" />
        <TextBlock Text="{Binding FileSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="내보내기 파일에는 사용자 고유 ID가 없어 이름만으로는 사람을 확정할 수 없습니다. 본인(나)을 직접 선택하고, 닉네임이 바뀐 경우 병합하거나 같은 이름의 다른 사람은 분리해 주세요." />

        <ListView ItemsSource="{Binding Participants}" SelectedItem="{Binding SelectedParticipant}" MaxHeight="260">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="이름" Width="180" DisplayMemberBinding="{Binding DisplayName}" />
              <GridViewColumn Header="다른 이름" Width="120" DisplayMemberBinding="{Binding AliasesText}" />
              <GridViewColumn Header="메시지" Width="70" DisplayMemberBinding="{Binding MessageCount}" />
              <GridViewColumn Header="처음" Width="125" DisplayMemberBinding="{Binding FirstSeen}" />
              <GridViewColumn Header="마지막" Width="125" DisplayMemberBinding="{Binding LastSeen}" />
              <GridViewColumn Header="상태" Width="90" DisplayMemberBinding="{Binding ConsentText}" />
              <GridViewColumn Header="" Width="210">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="본인으로 지정" Command="{Binding DataContext.SetOwnerCommand, ElementName=Root}" CommandParameter="{Binding}" />
                      <Button Content="{Binding ExcludeActionText}" Command="{Binding DataContext.ToggleExcludedCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>

        <TextBlock Text="선택한 사람의 메시지 예시 (이 PC에서만 표시)" Foreground="Gray" Margin="0,8,0,2" />
        <ItemsControl ItemsSource="{Binding SelectedSamples}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <GroupBox Header="닉네임 변경 · 같은 사람 병합" Margin="0,10,0,0" Padding="8">
          <StackPanel Orientation="Horizontal">
            <ComboBox Width="200" ItemsSource="{Binding Participants}" DisplayMemberPath="DisplayName" SelectedItem="{Binding MergeKeep}" Margin="0,0,8,0" />
            <TextBlock Text="에 다음 이름을 합치기:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="200" ItemsSource="{Binding Participants}" DisplayMemberPath="DisplayName" SelectedItem="{Binding MergeAbsorb}" Margin="0,0,8,0" />
            <Button Content="병합" Command="{Binding MergeCommand}" />
          </StackPanel>
        </GroupBox>

        <GroupBox Header="같은 이름의 다른 사람 분리" Margin="0,8,0,0" Padding="8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="목록에서 선택한 사람의 메시지 중" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding SplitDate}" Width="140" Margin="0,0,8,0" />
            <TextBlock Text="이후 메시지를 다른 사람으로" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Content="분리" Command="{Binding SplitCommand}" />
          </StackPanel>
        </GroupBox>

        <TextBlock Text="확인이 필요한 항목" FontWeight="SemiBold" Margin="0,10,0,4" />
        <ItemsControl ItemsSource="{Binding Suspicions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Content="확인함 (그대로 두기)"
                        Command="{Binding DataContext.AcknowledgeCommand, ElementName=Root}" CommandParameter="{Binding}"
                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="Gray" Margin="8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <TextBlock Text="데이터셋 이름(선택, 암호화 저장):" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Width="260" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding ValidationMessages}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding StringFormat=· {0}}" Foreground="#FFB00020" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="다음: 개인정보 검토" Command="{Binding ContinueToPrivacyCommand}" />
          <Button Content="처음부터" Command="{Binding RestartCommand}" />
          <TextBlock Text="개인정보를 검사하는 중..." VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </StackPanel>

      <!-- Step 4: privacy review (L4) -->
      <StackPanel Visibility="{Binding IsPrivacyStep, Converter={StaticResource BoolToVis}}">
        <TextBlock FontWeight="SemiBold" Text="4단계 · 개인정보 검토" Margin="0,0,0,6" />
        <TextBlock Text="{Binding PrivacyNotice}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="{Binding PrivacySummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="탐지된 개인정보가 없습니다. 그래도 민감한 내용이 없는지 한 번 더 확인해 주세요."
                   Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />

        <TextBlock Text="유형별로 한꺼번에 정하기" Foreground="Gray" Margin="0,0,0,2" />
        <ItemsControl ItemsSource="{Binding PrivacyTypes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Width="150" Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Width="130" Text="{Binding CategoryLabel}" Foreground="Gray" VerticalAlignment="Center" />
                <TextBlock Width="60" Text="{Binding Count, StringFormat={}{0}건}" VerticalAlignment="Center" />
                <ComboBox Width="160" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedItem="{Binding Selected}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="항목별로 정하기" Foreground="Gray" Margin="0,10,0,2" />
        <ListView ItemsSource="{Binding PrivacyFindings}" SelectedItem="{Binding SelectedFinding}" MaxHeight="280"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="유형" Width="120" DisplayMemberBinding="{Binding TypeLabel}" />
              <GridViewColumn Header="내용 (이 PC에서만 표시)" Width="460" DisplayMemberBinding="{Binding Excerpt}" />
              <GridViewColumn Header="처리" Width="170">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox Width="150" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedItem="{Binding Selected}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>

        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="원문 (이 PC 화면)" Foreground="Gray" />
            <TextBox Text="{Binding OriginalPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="AI(로컬 모델)가 받게 될 내용" Foreground="Gray" />
            <TextBox Text="{Binding LlmPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="암호화하여 저장" Command="{Binding SaveCommand}" />
          <Button Content="이전: 참여자 확인" Command="{Binding BackToSpeakersCommand}" />
          <TextBlock Text="저장하는 중..." VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </StackPanel>

      <!-- Step 4: done -->
      <StackPanel Visibility="{Binding IsCompletedStep, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="저장을 완료했습니다. 데이터는 이 PC에 암호화되어 저장되었습니다." Margin="0,0,0,8" />
        <Button Content="다른 파일 가져오기" Command="{Binding RestartCommand}" HorizontalAlignment="Left" />
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
