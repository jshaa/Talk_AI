<UserControl x:Class="TalkPro.App.Views.DatasetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource SectionTitle}" Text="내 데이터셋" />
      <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="가져온 대화는 이 PC에 데이터셋별 암호화 키로 저장됩니다. 삭제하면 키를 먼저 파기하므로 복구할 수 없습니다." />
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FF1F3A5F" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="새로고침" Command="{Binding RefreshCommand}" />
      <Button Content="선택한 데이터셋 분석" Command="{Binding AnalyzeSelectedCommand}" />
      <Button Content="선택한 데이터셋 삭제" Command="{Binding DeleteSelectedCommand}" />
      <Button Content="모든 데이터 삭제" Command="{Binding DeleteAllCommand}" Foreground="#FFB00020" />
    </StackPanel>
    <Grid>
      <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="이름" Width="260" DisplayMemberBinding="{Binding Title}" />
            <GridViewColumn Header="만든 날짜" Width="150" DisplayMemberBinding="{Binding CreatedText}" />
            <GridViewColumn Header="내용" Width="220" DisplayMemberBinding="{Binding CountsText}" />
            <GridViewColumn Header="상태" Width="160" DisplayMemberBinding="{Binding StateText}" />
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock Text="아직 가져온 대화가 없습니다. 왼쪽의 '가져오기'에서 시작하세요."
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DockPanel>
</UserControl>
