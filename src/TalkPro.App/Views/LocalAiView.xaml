<UserControl x:Class="TalkPro.App.Views.LocalAiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,12">
      <TextBlock Style="{StaticResource SectionTitle}" Text="로컬 AI" />
      <Border Background="#FFEFF4FA" Padding="10,6" Margin="0,0,0,8">
        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="상태 확인" Command="{Binding CheckCommand}" />
        <Button Content="연결 테스트" Command="{Binding TestCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <ListView ItemsSource="{Binding Models}" MaxHeight="280">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="모델" Width="120" DisplayMemberBinding="{Binding Name}" />
            <GridViewColumn Header="용도" Width="90" DisplayMemberBinding="{Binding Role}" />
            <GridViewColumn Header="라이선스" Width="140" DisplayMemberBinding="{Binding License}" />
            <GridViewColumn Header="승인" Width="160" DisplayMemberBinding="{Binding Approval}" />
            <GridViewColumn Header="상태" Width="150" DisplayMemberBinding="{Binding State}" />
            <GridViewColumn Header="설치 명령" Width="170">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBox Text="{Binding InstallCommand, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
      <TextBlock Text="연결 테스트 결과" FontWeight="SemiBold" Margin="0,16,0,4" />
      <TextBlock Text="{Binding TestOutput}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding TestLabel}" Foreground="#FF8A5A00" FontSize="11" Margin="0,4,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
