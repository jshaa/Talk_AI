<Window x:Class="TalkPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TalkPro.App.ViewModels"
        Title="TalkPro (작업명)" Width="1024" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FF1F3A5F" Padding="12,8">
      <TextBlock Foreground="White" Text="{Binding LocalOnlyNotice}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#FFF2F2F2" Padding="12,6">
      <TextBlock Foreground="#FF333333" Text="{Binding GenerativeAiNotice}" TextWrapping="Wrap" />
    </Border>
    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox Grid.Column="0" ItemsSource="{Binding Sections}" IsEnabled="False">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:NavigationSection}">
            <StackPanel Margin="4,6">
              <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
              <TextBlock FontSize="11" Foreground="Gray" Text="{Binding AvailableIn}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="개발 중 (MVP1 · Phase 0)" />
        <TextBlock Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="기능은 단계별로 활성화됩니다. 현재 버전은 데이터를 가져오거나 저장하지 않습니다." />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
