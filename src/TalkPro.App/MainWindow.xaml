<Window x:Class="TalkPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TalkPro.Presentation.ViewModels;assembly=TalkPro.Presentation"
        xmlns:views="clr-namespace:TalkPro.App.Views"
        Title="TalkPro (작업명)" Width="1100" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DatasetsViewModel}">
      <views:DatasetsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ImportWizardViewModel}">
      <views:ImportWizardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
      <views:AnalyticsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LocalAiViewModel}">
      <views:LocalAiView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReplyDraftViewModel}">
      <views:ReplyDraftView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MemorySearchViewModel}">
      <views:MemorySearchView />
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FF1F3A5F" Padding="12,8">
      <TextBlock Foreground="White" Text="{Binding LocalOnlyNotice}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#FFF2F2F2" Padding="12,6">
      <TextBlock Foreground="#FF333333" Text="{Binding GenerativeAiNotice}" TextWrapping="Wrap" />
    </Border>
    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <Button Content="데이터셋" Command="{Binding ShowDatasetsCommand}" Margin="0,0,0,6" HorizontalContentAlignment="Left" />
        <Button Content="가져오기" Command="{Binding ShowImportCommand}" Margin="0,0,0,6" HorizontalContentAlignment="Left" />
        <Button Content="답장 초안" Command="{Binding ShowDraftsCommand}" Margin="0,0,0,6" HorizontalContentAlignment="Left" />
        <Button Content="기억 검색" Command="{Binding ShowMemoryCommand}" Margin="0,0,0,6" HorizontalContentAlignment="Left" />
        <Button Content="로컬 AI" Command="{Binding ShowLocalAiCommand}" Margin="0,0,0,16" HorizontalContentAlignment="Left" />
        <TextBlock Text="준비 중" Foreground="Gray" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding UpcomingSections}" IsEnabled="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:NavigationSection}">
              <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Title}" Foreground="Gray" />
                <TextBlock FontSize="11" Foreground="Gray" Text="{Binding AvailableIn}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <ContentControl Grid.Column="1" Margin="16,0,0,0" Content="{Binding CurrentPage}" />
    </Grid>
  </DockPanel>
</Window>
