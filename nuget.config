<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain policy: restore only from nuget.org.
  <clear /> also isolates the build from machine-wide package sources.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
